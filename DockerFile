# Stage 1: build
FROM maven:3.9.122-alpine AS build
WORKDIR /app
RUN useradd -u 1001 nonroot
COPY  pom.xml .
COPY  src ./src
RUN --mount=type=cache,target=/root/.m2 \
  mvn dependency:go-offline
RUN --mount=type=cache,target=/root/.m2 \
  mvn clean package -DskipTests

# Stage 2: runtime
FROM eclipse-temurin:24-jre-alpine
WORKDIR /app
COPY --from=build /app/target/musify-0.0.1-SNAPSHOT.jar app.jar
USER nonroot

EXPOSE 8080
ENTRYPOINT ["java","-jar","app.jar"]